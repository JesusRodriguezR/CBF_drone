<?xml version="1.0" ?>
<!-- 40 m x 30 m greenhouse: 5 low crop rows, 1.00 m clear aisles, and hanging tutor strings. -->
<sdf version="1.8">
  <world name="greenhouse">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static><link name="ground">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>40 30</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>40 30</size></plane></geometry>
          <material><ambient>0.30 0.30 0.30 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="greenhouse_walls">
      <static>true</static><link name="walls">
        <collision name="west"><pose>-20 0 2 0 0 0</pose><geometry><box><size>0.20 30 4</size></box></geometry></collision>
        <collision name="east"><pose>20 0 2 0 0 0</pose><geometry><box><size>0.20 30 4</size></box></geometry></collision>
        <collision name="south"><pose>0 -15 2 0 0 0</pose><geometry><box><size>40 0.20 4</size></box></geometry></collision>
        <collision name="north"><pose>0 15 2 0 0 0</pose><geometry><box><size>40 0.20 4</size></box></geometry></collision>
        <visual name="west_visual"><pose>-20 0 2 0 0 0</pose><geometry><box><size>0.20 30 4</size></box></geometry></visual>
        <visual name="east_visual"><pose>20 0 2 0 0 0</pose><geometry><box><size>0.20 30 4</size></box></geometry></visual>
        <visual name="south_visual"><pose>0 -15 2 0 0 0</pose><geometry><box><size>40 0.20 4</size></box></geometry></visual>
        <visual name="north_visual"><pose>0 15 2 0 0 0</pose><geometry><box><size>40 0.20 4</size></box></geometry></visual>
      </link>
    </model>

    <!-- Five compact rows centered in the greenhouse. Crop tops are just
         above the 0.50 m drone transition height. Tutor strings hang from
         the overhead trellis down to each crop row. -->
    <model name="crop_rows">
      <static>true</static>
      <link name="rows">
        <collision name="crop_01_collision"><pose>0 -3.00 0.325 0 0 0</pose><geometry><box><size>34.0 0.50 0.65</size></box></geometry></collision>
        <visual name="crop_01"><pose>0 -3.00 0.325 0 0 0</pose><geometry><box><size>34.0 0.50 0.65</size></box></geometry><material><diffuse>0.08 0.35 0.04 1</diffuse></material></visual>
        <collision name="crop_02_collision"><pose>0 -1.50 0.325 0 0 0</pose><geometry><box><size>34.0 0.50 0.65</size></box></geometry></collision>
        <visual name="crop_02"><pose>0 -1.50 0.325 0 0 0</pose><geometry><box><size>34.0 0.50 0.65</size></box></geometry><material><diffuse>0.08 0.35 0.04 1</diffuse></material></visual>
        <collision name="crop_03_collision"><pose>0 0.00 0.325 0 0 0</pose><geometry><box><size>34.0 0.50 0.65</size></box></geometry></collision>
        <visual name="crop_03"><pose>0 0.00 0.325 0 0 0</pose><geometry><box><size>34.0 0.50 0.65</size></box></geometry><material><diffuse>0.08 0.35 0.04 1</diffuse></material></visual>
        <collision name="crop_04_collision"><pose>0 1.50 0.325 0 0 0</pose><geometry><box><size>34.0 0.50 0.65</size></box></geometry></collision>

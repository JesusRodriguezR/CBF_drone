        <collision name="crop_05_collision"><pose>0 3.00 0.325 0 0 0</pose><geometry><box><size>34.0 0.50 0.65</size></box></geometry></collision>
        <visual name="crop_05"><pose>0 3.00 0.325 0 0 0</pose><geometry><box><size>34.0 0.50 0.65</size></box></geometry><material><diffuse>0.08 0.35 0.04 1</diffuse></material></visual>
        <visual name="tutor_r1_s001"><pose>-16.80 -3.00 1.45 0 0 0</pose><geometry><cylinder><radius>0.0015</radius><length>1.60</length></cylinder></geometry><material><diffuse>0.70 0.58 0.32 1</diffuse></material></visual>
